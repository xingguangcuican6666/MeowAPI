# Build artifacts
/meowapi
/instrcheck
/dist/
*.exe
*.test
*.out

# Editor and OS noise
.DS_Store
*.swp
.idea/
.vscode/*
!.vscode/settings.json

# Runtime data: a module's data root, audit spill files and kernel dumps are
# operator state, never source.
/data/
*.audit.log

# Local environment overrides
.env
.env.local

# Claude Code session state. .claude/worktrees/ holds agent working trees, each of
# which is itself a git checkout, so staging one with `git add -A` would embed a
# repository inside this one and silently commit another session's work in progress.
.claude/

# mirror/ is the owner's private design reference: a Java prototype that exists to
# explain the intended semantics and is not part of what this repository publishes.
# It is ignored in full, not just its build output, and the ignore is what makes
# that true for a fresh clone as well as this worktree.
mirror/
